<div class="portfolio-trust-item" {{ block.shopify_attributes }}>
  <span class="portfolio-trust-item__icon" aria-hidden="true">
    {% case block.settings.icon %}
      {% when 'shopify' %}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6.5 7.8h11l1 12.2h-13l1-12.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M8.8 8c.2-2.7 1.2-4 3.1-4 1.8 0 2.8 1.3 3 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <path d="M14.1 11.6c-.6-.4-1.2-.6-1.9-.6-1 0-1.6.5-1.6 1.2 0 1.8 3.4 1.1 3.4 3.5 0 1.2-1 2.1-2.6 2.1-.8 0-1.6-.3-2.2-.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      {% when 'code' %}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="m8.5 6-5 6 5 6M15.5 6l5 6-5 6M13.8 3.5 10.2 20.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {% when 'delivery' %}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="m13.5 2-8 12h6l-1 8 8-12h-6l1-8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
      {% when 'chat' %}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 4.5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-4.5 3v-3H5a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M8 11h.01M12 11h.01M16 11h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
    {% endcase %}
  </span>

  <span class="portfolio-trust-item__label">{{ block.settings.label | escape }}</span>
</div>

{% schema %}
{
  "name": "Portfolio trust item",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "shopify",
          "label": "Shopify"
        },
        {
          "value": "code",
          "label": "Code"
        },
        {
          "value": "delivery",
          "label": "Delivery"
        },
        {
          "value": "chat",
          "label": "Chat"
        }
      ],
      "default": "shopify"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shopify specialist"
    }
  ],
  "presets": [
    {
      "name": "Portfolio trust item",
      "category": "Portfolio"
    }
  ]
}
{% endschema %}
