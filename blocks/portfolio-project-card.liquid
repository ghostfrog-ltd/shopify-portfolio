{% liquid
  case block.settings.fallback_image
    when 'orders'
      assign fallback_asset = 'portfolio-project-order-integration.webp'
    when 'migration'
      assign fallback_asset = 'portfolio-project-magento-migration.webp'
    else
      assign fallback_asset = 'portfolio-hero-cyclist.webp'
  endcase
%}

{% capture project_media %}
  {% if block.settings.image != blank %}
    {{
      block.settings.image
      | image_url: width: 1400
      | image_tag:
        widths: '480, 720, 960, 1200, 1400',
        sizes: '(min-width: 1000px) 32vw, (min-width: 650px) 48vw, 100vw',
        class: 'portfolio-project-card__image',
        loading: 'lazy',
        alt: block.settings.image_alt
    }}
  {% else %}
    <img
      src="{{ fallback_asset | asset_url }}"
      class="portfolio-project-card__image"
      width="1672"
      height="941"
      loading="lazy"
      alt="{{ block.settings.image_alt | escape }}"
    >
  {% endif %}

  {% if block.settings.image == blank and block.settings.fallback_image == 'cycling' %}
    <span class="portfolio-project-card__demo-overlay" aria-hidden="true">
      <span>VÉLO</span>
      <strong>Performance<br>beyond limits.</strong>
      <small>Shop now →</small>
    </span>
  {% endif %}
{% endcapture %}

<article class="portfolio-project-card" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank %}
    <a
      class="portfolio-project-card__media"
      href="{{ block.settings.link }}"
      {% if block.settings.open_in_new_tab %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}
      aria-label="{{ block.settings.title | escape }}"
    >
      {{ project_media }}
    </a>
  {% else %}
    <div class="portfolio-project-card__media">
      {{ project_media }}
    </div>
  {% endif %}

  <div class="portfolio-project-card__content">
    {% if block.settings.title != blank %}
      <h3 class="portfolio-project-card__title">
        {% if block.settings.link != blank %}
          <a
            href="{{ block.settings.link }}"
            {% if block.settings.open_in_new_tab %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            {{ block.settings.title | escape }}
          </a>
        {% else %}
          {{ block.settings.title | escape }}
        {% endif %}
      </h3>
    {% endif %}

    {% if block.settings.badge != blank %}
      <span class="portfolio-project-card__badge">{{ block.settings.badge | escape }}</span>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="portfolio-project-card__description rte">{{ block.settings.description }}</div>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .portfolio-project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .portfolio-project-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid #242c2a;
    border-radius: 9px;
    background: #111718;
    color: inherit;
    text-decoration: none;
  }

  .portfolio-project-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .portfolio-project-card:hover .portfolio-project-card__image {
    transform: scale(1.025);
  }

  .portfolio-project-card__demo-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    padding: 8% 7%;
    background: linear-gradient(90deg, rgb(4 8 9 / 72%), transparent 64%);
    color: #fff;
    flex-direction: column;
    align-items: flex-start;
    pointer-events: none;
  }

  .portfolio-project-card__demo-overlay > span {
    font-size: 0.48rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .portfolio-project-card__demo-overlay strong {
    margin-top: auto;
    font-size: clamp(1rem, 2vw, 1.8rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .portfolio-project-card__demo-overlay small {
    margin-top: 10px;
    padding: 5px 8px;
    border-radius: 999px;
    background: #fff;
    color: #0a0d0c;
    font-size: 0.45rem;
    font-weight: 700;
  }

  .portfolio-project-card__content {
    display: flex;
    padding-top: 18px;
    flex-direction: column;
    align-items: flex-start;
  }

  .portfolio-project-card__title {
    margin: 0;
    color: #f3f5f4;
    font-size: var(--gf-card-heading);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .portfolio-project-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .portfolio-project-card__badge {
    display: inline-flex;
    margin-top: 10px;
    padding: 3px 6px;
    border: 1px solid #3a4340;
    border-radius: 3px;
    color: #c6ccca;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .portfolio-project-card__description,
  .portfolio-project-card__description p {
    margin: 13px 0 0;
    color: #b4bab7;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-project-card__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portfolio project card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Default image",
      "info": "Used until an image is selected above.",
      "options": [
        {
          "value": "cycling",
          "label": "Cycling store"
        },
        {
          "value": "orders",
          "label": "Order integration"
        },
        {
          "value": "migration",
          "label": "Magento migration"
        }
      ],
      "default": "cycling"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Project preview"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Cycling Store – Theme Build"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Concept project"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A high-performance Shopify theme with custom sections and a conversion-focused product experience.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in a new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Portfolio project card",
      "category": "Portfolio"
    }
  ]
}
{% endschema %}
