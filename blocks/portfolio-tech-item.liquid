<div class="portfolio-tech-item" {{ block.shopify_attributes }}>
  <span class="portfolio-tech-item__icon" aria-hidden="true">
    {% if block.settings.custom_icon != blank %}
      {{
        block.settings.custom_icon
        | image_url: width: 120
        | image_tag: widths: '48, 72, 96, 120', sizes: '48px', loading: 'lazy', alt: '', class: 'portfolio-tech-item__image'
      }}
    {% else %}
      {% case block.settings.icon %}
        {% when 'shopify' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="M11 13.5h18l1.7 20h-21l1.3-20Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14.5 14c.3-4.5 2.1-7 5.4-7 3.1 0 4.8 2.4 5.1 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M24 20c-1-.7-2.1-1-3.2-1-1.8 0-2.8.8-2.8 2 0 3 5.8 1.8 5.8 5.9 0 2.1-1.7 3.6-4.4 3.6-1.5 0-2.8-.5-3.8-1.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        {% when 'liquid' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="M20 4S9 17.5 9 25a11 11 0 0 0 22 0C31 17.5 20 4 20 4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        {% when 'graphql' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="m20 5 13 7.5v15L20 35 7 27.5v-15L20 5Z" stroke="currentColor" stroke-width="1.8"/><path d="M20 5 7 27.5h26L20 5Zm0 30L7 12.5h26L20 35Z" stroke="currentColor" stroke-width="1.4"/><circle cx="20" cy="5" r="2" fill="currentColor"/><circle cx="7" cy="12.5" r="2" fill="currentColor"/><circle cx="7" cy="27.5" r="2" fill="currentColor"/><circle cx="20" cy="35" r="2" fill="currentColor"/><circle cx="33" cy="27.5" r="2" fill="currentColor"/><circle cx="33" cy="12.5" r="2" fill="currentColor"/></svg>
        {% when 'node' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="m20 4 14 8v16l-14 8-14-8V12l14-8Z" stroke="currentColor" stroke-width="2"/><text x="11" y="25" fill="currentColor" font-size="13" font-weight="700" font-family="Arial, sans-serif">JS</text></svg>
        {% when 'react' %}
          <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="2.6" fill="currentColor"/><ellipse cx="20" cy="20" rx="16" ry="6.2" stroke="currentColor" stroke-width="1.7"/><ellipse cx="20" cy="20" rx="16" ry="6.2" stroke="currentColor" stroke-width="1.7" transform="rotate(60 20 20)"/><ellipse cx="20" cy="20" rx="16" ry="6.2" stroke="currentColor" stroke-width="1.7" transform="rotate(120 20 20)"/></svg>
        {% when 'tailwind' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="M5 15c4-5.3 8.3-5.3 13 0 3.1 3.6 6.2 3.6 9.5 0 2.5-2.7 5-3.8 7.5-3.4-4 5.4-8.3 5.4-13 0-3.1-3.6-6.2-3.6-9.5 0C10 18.3 7.5 19.4 5 19c0-1.3 0-2.7 0-4Z" fill="currentColor" opacity=".9"/><path d="M5 24c4-5.3 8.3-5.3 13 0 3.1 3.6 6.2 3.6 9.5 0 2.5-2.7 5-3.8 7.5-3.4-4 5.4-8.3 5.4-13 0-3.1-3.6-6.2-3.6-9.5 0C10 27.3 7.5 28.4 5 28v-4Z" fill="currentColor" opacity=".55"/></svg>
        {% when 'magento' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="m20 4 14 8v16l-5 3V15l-9-5-9 5v16l-5-3V12l14-8Z" fill="currentColor"/><path d="m14 17 6-3.5 6 3.5v17l-5.8 3.3V20l-.2-.1-.2.1v17L14 34V17Z" fill="currentColor" opacity=".72"/></svg>
        {% when 'mysql' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="M7 26c8-1 12-6 13-14 4 1 7.7 4 9.2 8.2 2.2-.3 4.3.3 5.8 1.8-3.2.4-5.6 1.8-7.2 4.4-4.4 6.7-13.2 8.2-20.8 3.6 3.1.1 5.8-.7 8-2.5-2.8.5-5.5 0-8-1.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="24.5" cy="18.5" r="1" fill="currentColor"/></svg>
        {% when 'git' %}
          <svg viewBox="0 0 40 40" fill="none"><path d="m20 4 16 16-16 16L4 20 20 4Z" fill="currentColor" opacity=".9"/><path d="m13 13 13.5 13.5M17 17v9.5M17 17l5-5" stroke="#070b0c" stroke-width="2.2" stroke-linecap="round"/><circle cx="13" cy="13" r="2.2" fill="#070b0c"/><circle cx="17" cy="17" r="2.2" fill="#070b0c"/><circle cx="17" cy="27" r="2.2" fill="#070b0c"/><circle cx="27" cy="27" r="2.2" fill="#070b0c"/></svg>
      {% endcase %}
    {% endif %}
  </span>

  <span class="portfolio-tech-item__label">{{ block.settings.label | escape }}</span>
</div>

{% stylesheet %}
  .portfolio-tech-item {
    display: flex;
    min-width: 0;
    gap: 13px;
    align-items: center;
    color: #d2d7d5;
    flex-direction: column;
    text-align: center;
  }

  .portfolio-tech-item__icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    color: #c8cecb;
  }

  .portfolio-tech-item__icon svg,
  .portfolio-tech-item__image {
    display: block;
    width: 42px;
    height: 42px;
    object-fit: contain;
  }

  .portfolio-tech-item__label {
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portfolio technology",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Default icon",
      "options": [
        { "value": "shopify", "label": "Shopify" },
        { "value": "liquid", "label": "Liquid" },
        { "value": "graphql", "label": "GraphQL" },
        { "value": "node", "label": "Node.js" },
        { "value": "react", "label": "React" },
        { "value": "tailwind", "label": "Tailwind CSS" },
        { "value": "magento", "label": "Magento" },
        { "value": "mysql", "label": "MySQL" },
        { "value": "git", "label": "Git" }
      ],
      "default": "shopify"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shopify"
    }
  ],
  "presets": [
    {
      "name": "Portfolio technology",
      "category": "Portfolio"
    }
  ]
}
{% endschema %}
