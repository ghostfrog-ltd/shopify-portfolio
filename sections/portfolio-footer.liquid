{{ 'portfolio-footer.css' | asset_url | stylesheet_tag }}

<footer class="portfolio-footer">
  <div class="portfolio-footer__inner">
    <div class="portfolio-footer__top">
      <a class="portfolio-footer__brand" href="{{ routes.root_url }}">
        <span aria-hidden="true">/</span>{{ section.settings.brand_name | escape }}
      </a>

      <nav class="portfolio-footer__navigation" aria-label="Footer navigation">
        {% for block in section.blocks %}
          {% if block.type == 'navigation_link' %}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="portfolio-footer__socials" aria-label="Social links">
        {% for block in section.blocks %}
          {% if block.type == 'social_link' %}
            <a
              href="{{ block.settings.link }}"
              aria-label="{{ block.settings.label | escape }}"
              {% if block.settings.open_in_new_tab %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% case block.settings.icon %}
                {% when 'linkedin' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5.2 3.5A1.7 1.7 0 1 1 5.2 7a1.7 1.7 0 0 1 0-3.5ZM3.8 8.4h2.8v11.8H3.8V8.4Zm4.8 0h2.7V10h.1c.4-.8 1.5-2 3.6-2 3 0 4.2 1.8 4.2 5.2v7h-2.8v-6.5c0-1.8-.6-3-2.3-3-1.9 0-2.7 1.3-2.7 3.4v6.1H8.6V8.4Z"/>
                  </svg>
                {% when 'github' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12 2.6a9.6 9.6 0 0 0-3 18.7c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.7-1.3-2.3-.3-4.7-1.1-4.7-5a3.9 3.9 0 0 1 1-2.6c-.1-.3-.4-1.3.1-2.6 0 0 .9-.3 2.7 1a9.4 9.4 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .6 1.3.2 2.3.1 2.6a3.9 3.9 0 0 1 1 2.6c0 3.9-2.4 4.7-4.7 5 .4.3.7 1 .7 1.9v2.7c0 .3.2.6.7.5A9.6 9.6 0 0 0 12 2.6Z" clip-rule="evenodd"/>
                  </svg>
                {% when 'email' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4.2 5.7h15.6c.9 0 1.7.8 1.7 1.7v9.2c0 .9-.8 1.7-1.7 1.7H4.2c-.9 0-1.7-.8-1.7-1.7V7.4c0-.9.8-1.7 1.7-1.7Zm0 1.8 7.8 5.4 7.8-5.4H4.2Zm15.5 9V9.6L12.5 14a1 1 0 0 1-1 0L4.3 9.6v6.9h15.4Z"/>
                  </svg>
              {% endcase %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="portfolio-footer__bottom">
      <p>{{ section.settings.tagline | escape }}</p>
      <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | escape }}. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Portfolio footer",
  "tag": "section",
  "class": "portfolio-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "GhostFrog"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Shopify development for ambitious brands."
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "GhostFrog"
    }
  ],
  "blocks": [
    {
      "type": "navigation_link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "linkedin", "label": "LinkedIn" },
            { "value": "github", "label": "GitHub" },
            { "value": "email", "label": "Email" }
          ],
          "default": "linkedin"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessible label",
          "default": "Social profile"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in a new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio footer"
    }
  ]
}
{% endschema %}
