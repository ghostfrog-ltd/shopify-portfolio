{{ 'portfolio-newsletter.css' | asset_url | stylesheet_tag }}

{% assign newsletter_form_id = 'PortfolioNewsletter-' | append: section.id %}

<section
  class="portfolio-newsletter"
  aria-labelledby="PortfolioNewsletterHeading-{{ section.id }}"
>
  <div class="portfolio-newsletter__media" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1900, 2400',
          sizes: '100vw',
          class: 'portfolio-newsletter__image',
          loading: 'lazy',
          alt: ''
      }}
    {% else %}
      <img
        src="{{ 'portfolio-newsletter-mountains.webp' | asset_url }}"
        class="portfolio-newsletter__image"
        width="1916"
        height="821"
        loading="lazy"
        alt=""
      >
    {% endif %}
  </div>
  <div class="portfolio-newsletter__overlay" aria-hidden="true"></div>

  <div class="portfolio-newsletter__inner">
    <div class="portfolio-newsletter__content">
      {% if section.settings.eyebrow != blank %}
        <p class="portfolio-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 id="PortfolioNewsletterHeading-{{ section.id }}" class="portfolio-newsletter__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="portfolio-newsletter__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    <div class="portfolio-newsletter__form-wrap">
      {% form 'customer', id: newsletter_form_id, class: 'portfolio-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {% if form.posted_successfully? %}
          <p class="portfolio-newsletter__success" role="status">
            {{ section.settings.success_message | escape }}
          </p>
        {% else %}
          {% if form.errors %}
            <div class="portfolio-newsletter__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="portfolio-newsletter__field">
            <label class="visually-hidden" for="PortfolioNewsletterEmail-{{ section.id }}">
              {{ section.settings.email_label | escape }}
            </label>
            <input
              id="PortfolioNewsletterEmail-{{ section.id }}"
              class="portfolio-newsletter__input"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
            <button class="portfolio-newsletter__button" type="submit">
              {{ section.settings.button_label | escape }}
              <span aria-hidden="true">→</span>
            </button>
          </div>
        {% endif %}
      {% endform %}

      {% if section.settings.disclaimer != blank %}
        <p class="portfolio-newsletter__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portfolio newsletter",
  "class": "portfolio-newsletter-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STAY IN THE LOOP"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get new articles in your inbox."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>No spam. Just practical insights on Shopify development, ecommerce and building better online stores.</p>"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Form note"
    }
  ],
  "presets": [
    {
      "name": "Portfolio newsletter"
    }
  ]
}
{% endschema %}
