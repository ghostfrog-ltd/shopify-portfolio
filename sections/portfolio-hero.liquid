{{ 'portfolio-hero.css' | asset_url | stylesheet_tag }}
{{ 'portfolio-home-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'portfolio-home-motion.js' | asset_url }}" defer></script>

{% capture hero_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<div class="portfolio-hero" id="home">
  <div class="portfolio-hero__inner">
    <div class="portfolio-hero__content">
      {{ hero_blocks }}
    </div>

    <div class="portfolio-hero__media">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2000
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2000',
            sizes: '(min-width: 1050px) 66vw, (min-width: 750px) 68vw, 120vw',
            class: 'portfolio-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image_alt
        }}
      {% else %}
        <img
          src="{{ 'portfolio-hero-tablet.webp' | asset_url }}"
          class="portfolio-hero__image"
          width="1672"
          height="941"
          alt="{{ section.settings.image_alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Portfolio hero",
  "class": "portfolio-section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Cyclist riding through a dramatic mountain landscape"
    }
  ],
  "presets": [{ "name": "Portfolio hero" }]
}
{% endschema %}
