{{ 'portfolio-services-page.css' | asset_url | stylesheet_tag }}

{% capture visuals_style %}
  {% if section.settings.visuals_image != blank %}
    --portfolio-services-visuals: url('{{ section.settings.visuals_image | image_url: width: 2400 }}');
  {% else %}
    --portfolio-services-visuals: url('{{ 'portfolio-services-visuals.png' | asset_url }}');
  {% endif %}
{% endcapture %}

<section
  class="portfolio-services-page"
  style="{{ visuals_style | strip }}"
  aria-labelledby="PortfolioServicesHeading-{{ section.id }}"
>
  <div class="portfolio-services-page__hero">
    <div class="portfolio-services-page__hero-media" aria-hidden="true"></div>
    <div class="portfolio-services-page__hero-overlay" aria-hidden="true"></div>
    <div class="portfolio-services-page__inner portfolio-services-page__hero-inner">
      <div class="portfolio-services-page__hero-copy">
        <p class="portfolio-services-page__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1 id="PortfolioServicesHeading-{{ section.id }}">
          {{ section.settings.hero_heading | escape }}<span aria-hidden="true">.</span>
        </h1>
        <div class="portfolio-services-page__lead rte">{{ section.settings.hero_text }}</div>
        <div class="portfolio-services-page__actions">
          <a class="portfolio-services-page__button" href="{{ section.settings.hero_primary_link }}">
            {{ section.settings.hero_primary_label | escape }} <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="portfolio-services-page__text-link" href="{{ section.settings.hero_secondary_link }}">
            {{ section.settings.hero_secondary_label | escape }} <span aria-hidden="true">&rsaquo;</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="portfolio-services-page__body">
    <div class="portfolio-services-page__inner">
      <div class="portfolio-services-page__section-heading">
        <div>
          <p class="portfolio-services-page__eyebrow">{{ section.settings.services_eyebrow | escape }}</p>
          <h2>{{ section.settings.services_heading | escape }}</h2>
        </div>
        <div class="rte">{{ section.settings.services_text }}</div>
      </div>

      <div class="portfolio-services-page__grid">
        {% for block in section.blocks %}
          {% if block.type == 'service' %}
            <a class="portfolio-services-page__service" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              <span class="portfolio-services-page__service-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'code' %}
                    <svg viewBox="0 0 24 24"><path d="m9 6-6 6 6 6M15 6l6 6-6 6M14 3l-4 18"/></svg>
                  {% when 'database' %}
                    <svg viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6M4 11.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/></svg>
                  {% when 'migration' %}
                    <svg viewBox="0 0 24 24"><path d="M5 8h12M14 5l3 3-3 3M19 16H7M10 13l-3 3 3 3"/></svg>
                  {% when 'growth' %}
                    <svg viewBox="0 0 24 24"><path d="M4 20V11h4v9M10 20V7h4v13M16 20V3h4v17M3 20h18"/></svg>
                  {% when 'support' %}
                    <svg viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12H2.5v5H6v-5H4ZM20 12h1.5v5H18v-5h2ZM18 18c0 1.1-.9 2-2 2h-3"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24"><path d="M6 7h12l1 14H5L6 7ZM9 9V5a3 3 0 0 1 6 0v4"/></svg>
                {% endcase %}
              </span>
              <h3>{{ block.settings.heading | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
              <span class="portfolio-services-page__service-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <div class="portfolio-services-page__process">
        <p class="portfolio-services-page__eyebrow">{{ section.settings.process_eyebrow | escape }}</p>
        <h2>{{ section.settings.process_heading | escape }}</h2>
        <ol>
          {% assign process_number = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'process_step' %}
              {% assign process_number = process_number | plus: 1 %}
              <li {{ block.shopify_attributes }}>
                <div class="portfolio-services-page__step-line">
                  <span>{{ process_number | prepend: '0' }}</span><i aria-hidden="true"></i>
                </div>
                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </li>
            {% endif %}
          {% endfor %}
        </ol>
      </div>

      <div class="portfolio-services-page__results">
        <div class="portfolio-services-page__results-media" aria-hidden="true"></div>
        <div class="portfolio-services-page__results-overlay" aria-hidden="true"></div>
        <div class="portfolio-services-page__results-copy">
          <p class="portfolio-services-page__eyebrow">{{ section.settings.results_eyebrow | escape }}</p>
          <h2>{{ section.settings.results_heading | escape }}</h2>
          <a class="portfolio-services-page__outline-button" href="{{ section.settings.results_link }}">
            {{ section.settings.results_label | escape }} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="portfolio-services-page__stats">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="portfolio-services-page__stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.value | escape }}</strong>
                <span>{{ block.settings.label | escape }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="portfolio-services-page__cta">
        <div>
          <p class="portfolio-services-page__eyebrow">{{ section.settings.cta_eyebrow | escape }}</p>
          <h2>{{ section.settings.cta_heading | escape }}</h2>
          <p>{{ section.settings.cta_text | escape }}</p>
        </div>
        <div class="portfolio-services-page__cta-action">
          <a class="portfolio-services-page__button" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label | escape }} <span aria-hidden="true">&rarr;</span>
          </a>
          {% if section.settings.cta_note != blank %}<small>{{ section.settings.cta_note | escape }}</small>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portfolio services page",
  "class": "portfolio-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "visuals_image", "label": "Frog and results artwork" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Services" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Shopify done properly" },
    { "type": "richtext", "id": "hero_text", "label": "Text", "default": "<p>High-performance Shopify stores, custom development and integrations for brands that want more.</p>" },
    { "type": "text", "id": "hero_primary_label", "label": "Primary button", "default": "Start a project" },
    { "type": "url", "id": "hero_primary_link", "label": "Primary link" },
    { "type": "text", "id": "hero_secondary_label", "label": "Secondary link label", "default": "See our work" },
    { "type": "url", "id": "hero_secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Services" },
    { "type": "text", "id": "services_eyebrow", "label": "Eyebrow", "default": "What we do" },
    { "type": "text", "id": "services_heading", "label": "Heading", "default": "Services built for serious brands." },
    { "type": "richtext", "id": "services_text", "label": "Text", "default": "<p>From strategy to scale, we help ambitious brands get the most out of Shopify — with clean design, solid development and ongoing support.</p>" },
    { "type": "header", "content": "Process" },
    { "type": "text", "id": "process_eyebrow", "label": "Eyebrow", "default": "Our process" },
    { "type": "text", "id": "process_heading", "label": "Heading", "default": "Straightforward. Collaborative. Effective." },
    { "type": "header", "content": "Results" },
    { "type": "text", "id": "results_eyebrow", "label": "Eyebrow", "default": "Real results" },
    { "type": "text", "id": "results_heading", "label": "Heading", "default": "Built for brands that go further." },
    { "type": "text", "id": "results_label", "label": "Button label", "default": "See our work" },
    { "type": "url", "id": "results_link", "label": "Button link" },
    { "type": "header", "content": "Final CTA" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Let’s talk" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Ready to start your project?" },
    { "type": "text", "id": "cta_text", "label": "Text", "default": "Tell us about your idea and we’ll get back to you shortly." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start a project" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta_note", "label": "Button note", "default": "No obligation. Just a conversation." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "store", "label": "Store" }, { "value": "code", "label": "Code" }, { "value": "database", "label": "Database" }, { "value": "migration", "label": "Migration" }, { "value": "growth", "label": "Growth" }, { "value": "support", "label": "Support" }], "default": "store" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shopify Store Builds" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Custom, conversion-focused stores designed to grow with your brand." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "process_step",
      "name": "Process step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Discovery" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We learn about your brand, goals and technical needs." }
      ]
    },
    {
      "type": "stat",
      "name": "Result statistic",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "+167%" },
        { "type": "text", "id": "label", "label": "Label", "default": "average conversion increase" }
      ]
    }
  ],
  "presets": [{ "name": "Portfolio services page" }]
}
{% endschema %}
