{{ 'portfolio-contact.css' | asset_url | stylesheet_tag }}

{% liquid
  assign form_id = 'PortfolioContactForm-' | append: section.id
%}

<section class="portfolio-contact" aria-labelledby="PortfolioContactHeading-{{ section.id }}">
  <div class="portfolio-contact__media" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1900, 2400',
          sizes: '100vw',
          class: 'portfolio-contact__background',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {% else %}
      <img
        src="{{ 'portfolio-blog-hero-mountains.webp' | asset_url }}"
        class="portfolio-contact__background"
        width="1800"
        height="1013"
        loading="eager"
        fetchpriority="high"
        alt=""
      >
    {% endif %}
  </div>
  <div class="portfolio-contact__overlay" aria-hidden="true"></div>

  <div class="portfolio-contact__inner">
    <header class="portfolio-contact__hero">
      <div class="portfolio-contact__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="portfolio-contact__eyebrow">
            <span aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h1 id="PortfolioContactHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>

        {% if section.settings.intro != blank %}
          <div class="portfolio-contact__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>

      {% if section.settings.side_note != blank %}
        <p class="portfolio-contact__side-note">{{ section.settings.side_note | newline_to_br }}</p>
      {% endif %}
    </header>

    <div class="portfolio-contact__panel">
      <div class="portfolio-contact__form-column" id="contact-form">
        <div class="portfolio-contact__column-heading">
          <h2>{{ section.settings.form_heading | escape }}</h2>
          {% if section.settings.form_intro != blank %}<p>{{ section.settings.form_intro | escape }}</p>{% endif %}
        </div>

        {%- form 'contact', id: form_id, class: 'portfolio-contact__form' -%}
          {% if form.errors %}
            <div class="portfolio-contact__form-message portfolio-contact__form-message--error" role="alert" tabindex="-1">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <div class="portfolio-contact__form-message portfolio-contact__form-message--success" role="status" tabindex="-1">
              {{ section.settings.success_message | escape }}
            </div>
          {% endif %}

          <div class="portfolio-contact__form-grid">
            <label class="portfolio-contact__field">
              <span>{{ section.settings.name_label | escape }} <b aria-hidden="true">*</b></span>
              <input
                type="text"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                placeholder="{{ section.settings.name_placeholder | escape }}"
                required
              >
            </label>

            <label class="portfolio-contact__field">
              <span>{{ section.settings.email_label | escape }} <b aria-hidden="true">*</b></span>
              <input
                type="email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                required
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              >
            </label>

            <label class="portfolio-contact__field portfolio-contact__field--full">
              <span>{{ section.settings.company_label | escape }}</span>
              <input
                type="text"
                name="contact[company]"
                autocomplete="organization"
                placeholder="{{ section.settings.company_placeholder | escape }}"
              >
            </label>

            <label class="portfolio-contact__field portfolio-contact__field--full portfolio-contact__field--select">
              <span>{{ section.settings.service_label | escape }} <b aria-hidden="true">*</b></span>
              <select name="contact[project_type]" required>
                <option value="" selected disabled>{{ section.settings.service_placeholder | escape }}</option>
                {% for index in (1..6) %}
                  {% assign option_key = 'service_option_' | append: index %}
                  {% assign option = section.settings[option_key] %}
                  {% if option != blank %}<option value="{{ option | escape }}">{{ option | escape }}</option>{% endif %}
                {% endfor %}
              </select>
            </label>

            <label class="portfolio-contact__field portfolio-contact__field--full portfolio-contact__field--textarea">
              <span>{{ section.settings.message_label | escape }} <b aria-hidden="true">*</b></span>
              <textarea
                name="contact[body]"
                rows="6"
                placeholder="{{ section.settings.message_placeholder | escape }}"
                required
              >{{ form.body }}</textarea>
            </label>
          </div>

          <div class="portfolio-contact__form-footer">
            <button type="submit" class="portfolio-contact__submit">
              <span>{{ section.settings.submit_label | escape }}</span><span aria-hidden="true">&rarr;</span>
            </button>
            <p>
              {{ section.settings.response_note | escape }}
              {% if section.settings.spam_note != blank %}<span>{{ section.settings.spam_note | escape }}</span>{% endif %}
            </p>
          </div>
        {%- endform -%}
      </div>

      <aside class="portfolio-contact__details" aria-labelledby="PortfolioContactDetails-{{ section.id }}">
        <div class="portfolio-contact__column-heading">
          <h2 id="PortfolioContactDetails-{{ section.id }}">{{ section.settings.details_heading | escape }}</h2>
          {% if section.settings.details_intro != blank %}<p>{{ section.settings.details_intro | escape }}</p>{% endif %}
        </div>

        <div class="portfolio-contact__detail-list">
          {% for block in section.blocks %}
            {% if block.type == 'contact_detail' %}
              <div class="portfolio-contact__detail" {{ block.shopify_attributes }}>
                <span class="portfolio-contact__detail-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'phone' %}
                      <svg viewBox="0 0 24 24"><path d="M7.2 3.5 10 7.1 8.35 9.6c1.2 2.5 3.25 4.55 5.75 5.75l2.5-1.65 3.6 2.8v2.1c0 1.05-.85 1.9-1.9 1.9C10.12 20.5 3.5 13.88 3.5 5.7c0-1.05.85-1.9 1.9-1.9l1.8-.3Z"/></svg>
                    {% when 'location' %}
                      <svg viewBox="0 0 24 24"><path d="M19 9.5c0 5-7 11-7 11s-7-6-7-11a7 7 0 1 1 14 0Z"/><circle cx="12" cy="9.5" r="2.25"/></svg>
                    {% when 'calendar' %}
                      <svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="14.5" rx="1.5"/><path d="M8 3.5v4M16 3.5v4M4 10h16"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m4 7 8 6 8-6"/></svg>
                  {% endcase %}
                </span>
                <div>
                  <h3>{{ block.settings.heading | escape }}</h3>
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
                  {% elsif block.settings.link_label != blank %}
                    <p class="portfolio-contact__detail-value">{{ block.settings.link_label | escape }}</p>
                  {% endif %}
                  {% if block.settings.meta != blank %}<p>{{ block.settings.meta | escape }}</p>{% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="portfolio-contact__next">
          <h3>{{ section.settings.next_heading | escape }}</h3>
          <ol>
            {% assign step_number = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'next_step' %}
                {% assign step_number = step_number | plus: 1 %}
                <li {{ block.shopify_attributes }}><span>{{ step_number }}</span><p>{{ block.settings.text | escape }}</p></li>
              {% endif %}
            {% endfor %}
          </ol>
        </div>
      </aside>
    </div>

    <div class="portfolio-contact__trust" aria-label="Why work with GhostFrog">
      {% for block in section.blocks %}
        {% if block.type == 'trust_item' %}
          <div class="portfolio-contact__trust-item" {{ block.shopify_attributes }}>
            <span aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'bolt' %}
                  <svg viewBox="0 0 24 24"><path d="m13.5 2.5-8 11h6l-1 8 8-11h-6l1-8Z"/></svg>
                {% when 'chat' %}
                  <svg viewBox="0 0 24 24"><path d="M4 4.5h16v12H9l-5 4v-16Z"/><path d="M8 10.5h.01M12 10.5h.01M16 10.5h.01"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24"><path d="m9 5-5 7 5 7M15 5l5 7-5 7M13.5 3l-3 18"/></svg>
              {% endcase %}
            </span>
            <div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portfolio contact",
  "class": "portfolio-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let’s build what’s next." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Have a project in mind, a technical challenge, or just want to pick my brain? Drop me a message and I’ll get back to you as soon as possible.</p>" },
    { "type": "textarea", "id": "side_note", "label": "Decorative side note", "default": "Better\ncommerce\nfurther" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Heading", "default": "Send a message" },
    { "type": "text", "id": "form_intro", "label": "Introduction", "default": "Tell me a bit about your project and I’ll be in touch." },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "name_placeholder", "label": "Name placeholder", "default": "John Smith" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Your email" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@company.com" },
    { "type": "text", "id": "company_label", "label": "Company label", "default": "Company (optional)" },
    { "type": "text", "id": "company_placeholder", "label": "Company placeholder", "default": "Your company name" },
    { "type": "text", "id": "service_label", "label": "Service label", "default": "What can I help with?" },
    { "type": "text", "id": "service_placeholder", "label": "Service placeholder", "default": "Select an option" },
    { "type": "text", "id": "service_option_1", "label": "Service option 1", "default": "Shopify theme development" },
    { "type": "text", "id": "service_option_2", "label": "Service option 2", "default": "Apps and integrations" },
    { "type": "text", "id": "service_option_3", "label": "Service option 3", "default": "Magento to Shopify migration" },
    { "type": "text", "id": "service_option_4", "label": "Service option 4", "default": "Performance and optimisation" },
    { "type": "text", "id": "service_option_5", "label": "Service option 5", "default": "Ongoing development support" },
    { "type": "text", "id": "service_option_6", "label": "Service option 6", "default": "Something else" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Your message" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "Tell me about your project, goals, timelines, or any questions…" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Send message" },
    { "type": "text", "id": "response_note", "label": "Response note", "default": "I typically respond within 1 business day." },
    { "type": "text", "id": "spam_note", "label": "Spam note", "default": "No spam. No nonsense." },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — your message has been sent. I’ll be in touch shortly." },
    { "type": "header", "content": "Direct contact" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "Get in touch directly" },
    { "type": "text", "id": "details_intro", "label": "Introduction", "default": "Prefer email or a quick call? Here are the details." },
    { "type": "text", "id": "next_heading", "label": "Next steps heading", "default": "What happens next?" }
  ],
  "blocks": [
    {
      "type": "contact_detail",
      "name": "Contact detail",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "email", "label": "Email" }, { "value": "phone", "label": "Phone" }, { "value": "location", "label": "Location" }, { "value": "calendar", "label": "Calendar" }], "default": "email" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Email" },
        { "type": "text", "id": "link_label", "label": "Value or link label", "default": "hello@ghostfrog.co" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "meta", "label": "Supporting text", "default": "Usually replies within 1 business day" }
      ]
    },
    {
      "type": "next_step",
      "name": "Next step",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "I’ll review your message." }]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "code", "label": "Code" }, { "value": "bolt", "label": "Bolt" }, { "value": "chat", "label": "Chat" }], "default": "code" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shopify expertise" },
        { "type": "text", "id": "text", "label": "Text", "default": "Themes. Apps. Integrations." }
      ]
    }
  ],
  "presets": [{ "name": "Portfolio contact" }]
}
{% endschema %}
